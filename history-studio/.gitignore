# Local installs, recreated by ./setup.sh
node_modules/
.venv/
.studio/
__pycache__/

# HyperFrames' local state and scratch files inside each video folder
**/.hyperframes/

# Narration WAVs, recreated by tools/voice.py (a compressed copy is kept)
*/audio/*.wav
*/audio/sections/

# Generated narration copy for HyperFrames (from audio/narration.wav)
*/assets/narration.wav

# Full-length renders (too big for git; the phone copy is sent in chat)
*/renders/chunks/
*/renders/the-army-that-walked-across-the-sea*.mp4
*/renders/render.log
